# VendaMais — variáveis de ambiente
# Copie para `.env.local` e preencha com os valores do seu projeto Supabase.
# NUNCA commite valores reais — este arquivo só documenta os nomes.

# Supabase (Settings → API do projeto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Service role — SÓ no servidor. Jamais prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base da API. A aplicação serve a própria API em /api — deixe assim.
NEXT_PUBLIC_API_URL=/api

# Opcional, só para desenvolvimento com túnel (npm run dev:tunnel)
NGROK_AUTHTOKEN=

# Autentica o Vercel Cron em /api/cron/keep-alive (keep-alive diário do
# Supabase). String aleatória forte — gere com `openssl rand -hex 32`.
CRON_SECRET=
